datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  previewFeatures      = []
}

model Log {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  level   String
  message String
  time    DateTime @default(now())
  context Json?
}

model SentMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phones    String[]
  status    String
  createdAt DateTime @default(now())
}
